[Unit]
Description=c_datum_prime DATUM pool server (translated from RATUM Prime by iohzrd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Stable symlink: ln -sfn /path/to/c_datum_prime %h/.local/lib/c-datum-prime
# Keys/ledger/blocks are data/ next to the real binary via /proc/self/exe.
# Do not pass --keys/--ledger/--block-dir.
WorkingDirectory=%h/.local/lib/c-datum-prime
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/lib/c-datum-prime/build/c-datum-prime \
  --listen 0.0.0.0:28915 \
  --tag Blockvase \
  --min-diff 65536 \
  --payout-script 0014548ba41399d57523d5e14d5082b98859d19dfc99 \
  --source-listen 0.0.0.0:28916 \
  --source-url http://pool.blockvase.com:28916/ \
  --stats-listen 0.0.0.0:28917
Restart=always
RestartSec=10
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM
StandardOutput=append:%h/.local/lib/c-datum-prime/data/prime.log
StandardError=append:%h/.local/lib/c-datum-prime/data/prime.log
LimitNOFILE=65536

[Install]
WantedBy=default.target
