[Unit]
Description=c_datum_prime DATUM pool server (translated from RATUM Prime by iohzrd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dev
Group=dev
# Stable symlink: ln -sfn /path/to/c_datum_prime /home/dev/.local/lib/c-datum-prime
# Keys/ledger/blocks are data/ next to the real binary via /proc/self/exe.
# Do not pass --keys/--ledger/--block-dir.
WorkingDirectory=/home/dev/.local/lib/c-datum-prime
Environment=PATH=/home/dev/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/dev/.local/lib/c-datum-prime/build/c-datum-prime \
  --listen 0.0.0.0:28915 \
  --tag Blockvase \
  --min-diff 65536 \
  --payout-script 0014548ba41399d57523d5e14d5082b98859d19dfc99 \
  --source-listen 0.0.0.0:28916 \
  --source-url http://pool.blockvase.com:28916/ \
  --stats-listen 0.0.0.0:28917 \
  --fee-bps 21 \
  --fee-after-first-block
Restart=always
RestartSec=10
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM
StandardOutput=append:/home/dev/.local/lib/c-datum-prime/data/prime.log
StandardError=append:/home/dev/.local/lib/c-datum-prime/data/prime.log
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
